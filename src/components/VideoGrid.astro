---
import Icon from './Icon.astro';
import { youtube } from '../config';
import { latestVideos } from '../lib/youtube';

const videos = await latestVideos();
const [featured, ...rest] = videos;
const fmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
---

{
	videos.length === 0 ? (
		// No channel yet (or the feed couldn't be read): a "coming soon" card
		<div class="relative overflow-hidden rounded-2xl border border-line bg-surface/60 p-6 sm:p-8">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-yt/10 blur-3xl"
			/>
			<div class="flex items-center gap-3">
				<span class="grid size-11 place-items-center rounded-xl bg-yt/15 text-yt">
					<Icon name="youtube" class="size-6" />
				</span>
				<p class="eyebrow">Channel launching soon</p>
			</div>
			<p class="mt-5 max-w-md text-fg/90">
				I'm starting a channel about building things from first principles: rasterizers, layout solvers, typesetting,
				and the hardware on my desk. No frameworks hiding the interesting part.
			</p>
			<ul class="mt-6 grid gap-3 sm:grid-cols-3">
				{['Writing a 3D renderer with no graphics library', 'How a solver places objects so nothing overlaps', 'Typesetting math from scratch'].map(
					(idea, i) => (
						<li class="rounded-xl border border-dashed border-line p-4">
							<span class="font-mono text-xs text-dim">ep. {String(i + 1).padStart(2, '0')}</span>
							<p class="mt-1 text-sm leading-snug text-fg">{idea}</p>
						</li>
					),
				)}
			</ul>
			{youtube.url && (
				<a
					href={`${youtube.url}?sub_confirmation=1`}
					target="_blank"
					rel="noreferrer"
					class="mt-6 inline-flex items-center gap-2 rounded-full bg-yt px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
				>
					<Icon name="youtube" class="size-4" /> Subscribe
				</a>
			)}
		</div>
	) : (
		<div>
			{/* latest upload: a real player, but only loaded on click */}
			<lite-youtube
				videoid={featured.id}
				playlabel={`Play: ${featured.title}`}
				style={`background-image: url('https://i.ytimg.com/vi/${featured.id}/maxresdefault.jpg')`}
				class="overflow-hidden rounded-xl border border-line"
			/>
			<p class="mt-3 flex items-baseline justify-between gap-4">
				<span class="font-semibold text-fg">{featured.title}</span>
				{featured.published && <span class="shrink-0 font-mono text-xs text-dim">{fmt.format(featured.published)}</span>}
			</p>

			{rest.length > 0 && (
				<ul class="dim-group mt-8 grid gap-6 sm:grid-cols-2">
					{rest.map((v) => (
						<li class="dim-item">
							<a href={v.url} target="_blank" rel="noreferrer" class="group block">
								<div class="relative overflow-hidden rounded-lg border border-line">
									<img
										src={v.thumb}
										alt=""
										loading="lazy"
										width="480"
										height="360"
										class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.03]"
									/>
									<span class="absolute inset-0 grid place-items-center bg-black/0 transition group-hover:bg-black/30">
										<span class="grid size-12 scale-90 place-items-center rounded-full bg-yt text-white opacity-0 transition group-hover:scale-100 group-hover:opacity-100">
											<Icon name="play" class="size-5" />
										</span>
									</span>
								</div>
								<p class="mt-2 text-sm leading-snug font-medium text-fg transition-colors group-hover:text-accent">{v.title}</p>
								{v.published && <p class="font-mono text-xs text-dim">{fmt.format(v.published)}</p>}
							</a>
						</li>
					))}
				</ul>
			)}

			{youtube.url && (
				<a href={youtube.url} target="_blank" rel="noreferrer" class="link mt-8 inline-flex items-center gap-1 text-sm font-semibold">
					All videos on YouTube <Icon name="arrow" class="size-4" />
				</a>
			)}
		</div>
	)
}

<script>
	import 'lite-youtube-embed';
	import 'lite-youtube-embed/src/lite-yt-embed.css';
</script>
