---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Sohel Danial">
	<main class="grid min-h-dvh place-items-center px-6 text-center">
		<div>
			<p class="font-mono text-sm text-accent">404 · z-test failed</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight text-fg sm:text-5xl">Nothing was drawn here.</h1>
			<p class="mt-4">This page is behind something else in the depth buffer, or it doesn't exist.</p>
			<a href="/" class="mt-8 inline-block rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-bg transition hover:brightness-110">
				Back to the front
			</a>
		</div>
	</main>
</Base>
